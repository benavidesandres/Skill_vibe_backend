# Servidor
PORT=3000

# Base de datos (PostgreSQL en Docker)
DB_HOST=localhost
# Si ya tienes PostgreSQL instalado en tu PC (ocupa el 5432), usa 5433
DB_PORT=5432
DB_USERNAME=skillvibes
DB_PASSWORD=skillvibes
DB_NAME=skillvibes_db
# true solo en desarrollo: crea/actualiza las tablas a partir de las entidades
DB_SYNCHRONIZE=true

# JWT
JWT_SECRET=cambia_esto_por_un_secreto_largo
JWT_EXPIRES_IN=1d

# Videollamada simulada: URL del frontend, que sirve /sala.html
VIDEO_BASE_URL=http://localhost:5173
